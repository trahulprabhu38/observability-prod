# Copy to .env  ->  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- Grafana admin login ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- AWS (only needed for the "ecs" profile: YACE / CloudWatch) ---
# IAM user/role needs: cloudwatch:ListMetrics, cloudwatch:GetMetricData,
# cloudwatch:GetMetricStatistics, tag:GetResources, ecs:ListClusters,
# ecs:ListServices, ecs:DescribeServices   (read-only). See docs/05-ecs-metrics.md
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=ap-south-1
