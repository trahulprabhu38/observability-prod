{
  "uid": "obs-v2-stack-health",
  "title": "Observability v2 - Stack Health",
  "tags": ["observability-v2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "box",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(node_uname_info, box)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets UP",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(up)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "type": "stat",
      "title": "Scrape targets DOWN",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "count(up == 0) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "type": "stat",
      "title": "Running containers (cAdvisor)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "count(count by (name) (container_last_seen{name!=\"\"}))", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Log lines/sec into Loki",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(loki_distributor_lines_received_total[5m]))", "refId": "A" }]
    },
    {
      "type": "table",
      "title": "Scrape targets",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up", "instant": true, "format": "table", "refId": "A" }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "Value": false }, "renameByName": { "Value": "up" } } }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU busy % by box",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 - (avg by (box) (rate(node_cpu_seconds_total{mode=\"idle\", box=~\"$box\"}[5m])) * 100)", "legendFormat": "{{box}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Request rate by service (RED / span-metrics)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total[5m]))", "legendFormat": "{{service_name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Error rate by service",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "service:error_rate:5m", "legendFormat": "{{service_name}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
    },
    {
      "type": "logs",
      "title": "Recent error logs (all containers)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"docker\"} |~ \"(?i)(error|panic|fatal|exception)\"", "refId": "A" }],
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none" }
    }
  ]
}
