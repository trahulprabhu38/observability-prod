{
  "uid": "databases-box-group",
  "title": "Databases box",
  "description": "10.200.2.41. Per the inventory: nothing shows up here via the Coolify API today - either real DBs run directly on the box outside Coolify, or they're external/managed elsewhere. This dashboard assumes the former (node-exporter + postgres_exporter, staged in ../../../../../databases-box/) - confirm that assumption before trusting these panels. Source: PARTNER_APPS_AND_UAT_INVENTORY.md §6.",
  "tags": ["databases", "valura", "infra"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 42,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "row", "title": "status", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 2, "type": "text", "title": "",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "**Open question, not yet confirmed:** whether a real Postgres actually runs on this box outside Coolify's visibility, or whether DSP/Monarch/etc data lives elsewhere. node-exporter + postgres_exporter are staged in `databases-box/` but **not deployed**, so every panel below reads \"no data\" until that's resolved and deployed."
      }
    },
    {
      "id": 3, "type": "stat", "title": "node-exporter up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }],
        "noValue": "no data" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "up{job=\"node-fleet\", box=\"databases\"}", "instant": true }]
    },
    {
      "id": 4, "type": "stat", "title": "postgres_exporter up (pg_up)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }],
        "noValue": "no data" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "pg_up{box=\"databases\"}", "instant": true }]
    },
    {
      "id": 5, "type": "row", "title": "host", "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 6, "type": "stat", "title": "Host CPU busy",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 92 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-fleet\", box=\"databases\", mode=\"idle\"}[5m])))", "instant": true }]
    },
    {
      "id": 7, "type": "stat", "title": "RAM used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 85 }, { "color": "red", "value": 95 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-fleet\", box=\"databases\"} / node_memory_MemTotal_bytes{job=\"node-fleet\", box=\"databases\"})", "instant": true }]
    },
    {
      "id": 8, "type": "stat", "title": "Root FS used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-fleet\", box=\"databases\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-fleet\", box=\"databases\", mountpoint=\"/\"})", "instant": true }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Host disk I/O",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "Bps",
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 3, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_read_bytes_total{job=\"node-fleet\", box=\"databases\"}[$__rate_interval])", "legendFormat": "read {{device}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "- rate(node_disk_written_bytes_total{job=\"node-fleet\", box=\"databases\"}[$__rate_interval])", "legendFormat": "write {{device}}" }
      ]
    },
    {
      "id": 10, "type": "row", "title": "postgres", "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 11, "type": "stat", "title": "Active connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(pg_stat_database_numbackends{box=\"databases\"})", "instant": true }]
    },
    {
      "id": 12, "type": "stat", "title": "DB size (largest)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "max(pg_database_size_bytes{box=\"databases\"})", "instant": true }]
    },
    {
      "id": 13, "type": "timeseries", "title": "Transactions/sec by database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops",
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{box=\"databases\"}[$__rate_interval]))", "legendFormat": "{{datname}}" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "Connections by database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none",
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "pg_stat_database_numbackends{box=\"databases\"}", "legendFormat": "{{datname}}" }]
    }
  ]
}
