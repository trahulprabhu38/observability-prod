{
  "uid": "dsp-family-group",
  "title": "DSP Family (DSP / Monarch / Isolate / NIFM / Verifiedy)",
  "description": "All sit inside one Coolify project literally named `DSP`. Spans `valura-dev` (10.200.2.51, dev/preview tier) and `dubai` (86.106.26.45, prod/global DSP + Verifiedy staging). Source: PARTNER_APPS_AND_UAT_INVENTORY.md §3.",
  "tags": ["dsp", "monarch", "isolate", "nifm", "verifiedy", "valura"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 42,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "project",
        "label": "Coolify project",
        "query": "DSP",
        "current": { "text": "DSP", "value": "DSP" },
        "hide": 2
      },
      {
        "type": "query",
        "name": "resource",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(container_last_seen{container_label_coolify_projectName=\"DSP\"}, container_label_coolify_resourceName)",
        "query": {
          "qryType": 1,
          "query": "label_values(container_last_seen{container_label_coolify_projectName=\"DSP\"}, container_label_coolify_resourceName)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{coolify_project=\\\"DSP\\\"}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "row", "title": "overview", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 2, "type": "text", "title": "",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "**Known gap:** `dubai` (86.106.26.45) has no Alloy agent deployed yet, so logs/traces for the prod-global DSP + Verifiedy-staging containers running there are **not in this dashboard's log panels below** - only metrics are. `valura-dev` is fully covered. See `../../../../../dubai-box/README.md`."
      }
    },
    {
      "id": 3, "type": "stat", "title": "Running containers",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 3, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "count(container_last_seen{container_label_coolify_projectName=\"DSP\"})", "instant": true }]
    },
    {
      "id": 4, "type": "stat", "title": "Containers by box",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 3, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "name", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "count by (box) (container_last_seen{container_label_coolify_projectName=\"DSP\"})",
        "instant": true, "legendFormat": "{{box}}" }]
    },
    {
      "id": 5, "type": "stat", "title": "Restarts (1h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 10, "y": 3, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(changes(container_start_time_seconds{container_label_coolify_projectName=\"DSP\"}[1h])) or vector(0)", "instant": true }]
    },
    {
      "id": 6, "type": "stat", "title": "CPU cores",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 14, "y": 3, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_coolify_projectName=\"DSP\"}[5m]))", "instant": true }]
    },
    {
      "id": 7, "type": "stat", "title": "Memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 3, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(container_memory_working_set_bytes{container_label_coolify_projectName=\"DSP\"})", "instant": true }]
    },
    {
      "id": 8, "type": "row", "title": "service breakdown", "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 9, "type": "stat", "title": "Service status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 7 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
        "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }],
        "noValue": "no data" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "name", "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "instant": true,
        "expr": "max by (container_label_coolify_resourceName) ((time() - container_last_seen{container_label_coolify_projectName=\"DSP\", container_label_coolify_resourceName=~\"$resource\"}) < 60)",
        "legendFormat": "{{container_label_coolify_resourceName}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "CPU cores by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 3,
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (container_label_coolify_resourceName) (rate(container_cpu_usage_seconds_total{container_label_coolify_projectName=\"DSP\", container_label_coolify_resourceName=~\"$resource\"}[$__rate_interval]))",
        "legendFormat": "{{container_label_coolify_resourceName}}" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Memory by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes",
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (container_label_coolify_resourceName) (container_memory_working_set_bytes{container_label_coolify_projectName=\"DSP\", container_label_coolify_resourceName=~\"$resource\"})",
        "legendFormat": "{{container_label_coolify_resourceName}}" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "Restarts by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "none",
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": true, "gradientMode": "opacity", "stacking": { "mode": "none", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (container_label_coolify_resourceName) (changes(container_start_time_seconds{container_label_coolify_projectName=\"DSP\", container_label_coolify_resourceName=~\"$resource\"}[1h]))",
        "legendFormat": "{{container_label_coolify_resourceName}}" }]
    },
    {
      "id": 13, "type": "row", "title": "logs (valura-dev only - see gap note above)", "collapsed": false,
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }, "panels": []
    },
    {
      "id": 14, "type": "timeseries", "title": "Log volume by level",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "fatal" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
        "expr": "sum by (level) (count_over_time({coolify_project=\"DSP\", coolify_resource=~\"$resource\"}[$__interval]))",
        "legendFormat": "{{level}}", "queryType": "range" }]
    },
    {
      "id": 15, "type": "logs", "title": "Errors, warnings & exceptions",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 7 },
      "pluginVersion": "12.3.2",
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true,
        "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending", "enableInfiniteScrolling": false, "showControls": false },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{coolify_project=\"DSP\", coolify_resource=~\"$resource\"} |~ \"(?i)(error|warn|fatal|critical|exception|traceback|panic)\"",
        "maxLines": 300, "legendFormat": "" }]
    }
  ]
}
