          },
          "instant": true,
          "expr": "coolify_build_success{project=~\"Valura-development|global-valura-dev\", project=~\"$project\", rank=\"1\"}",
          "legendFormat": "{{project}} / {{environment}} / {{app}}"
        }
      ]
