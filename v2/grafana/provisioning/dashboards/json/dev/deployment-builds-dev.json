{
  "uid": "deployment-builds-dev",
  "title": "deployment-builds-dev",
  "tags": [
    "deployments",
    "coolify",
    "builds",
    "valura",
    "generated",
    "dev"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 42,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "project",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\"}, project)",
        "query": {
          "qryType": 1,
          "query": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\"}, project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "type": "query",
        "name": "app",
        "label": "Build log: app",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\", project=~\"$project\"}, app)",
        "query": {
          "qryType": 1,
          "query": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\", project=~\"$project\"}, app)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "type": "custom",
        "name": "rank",
        "label": "Build log: rank (1=latest)",
        "query": "1,2,3",
        "options": [
          {
            "text": "1",
            "value": "1",
            "selected": true
          },
          {
            "text": "2",
            "value": "2",
            "selected": false
          },
          {
            "text": "3",
            "value": "3",
            "selected": false
          }
        ],
        "current": {
          "text": "1",
          "value": "1"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "type": "query",
        "name": "deployment_uuid",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "hide": 2,
        "definition": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\", project=~\"$project\", app=\"$app\", rank=~\"$rank\"}, deployment_uuid)",
        "query": {
          "qryType": 1,
          "query": "label_values(coolify_build_success{project=~\"Valura-development|global-valura-dev\", project=~\"$project\", app=\"$app\", rank=~\"$rank\"}, deployment_uuid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 1
      }
    ]
  },
  "links": [
    {
      "title": "\u2194 deployments (live status)",
      "type": "link",
      "url": "/d/deployments-dev",
      "icon": "external link"
