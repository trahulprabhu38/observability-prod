{
  "uid": "uat-env-group",
  "title": "UAT (UAT-ind + UAT-uae)",
  "description": "Both Coolify environments (`UAT-ind`, `UAT-uae`) run on the single `UAT-environment` box (10.200.2.48). Already in node-fleet/cadvisor-fleet as `box=uat-env`; this dashboard is the missing per-app view. Source: PARTNER_APPS_AND_UAT_INVENTORY.md \u00a74.",
  "tags": [
    "uat",
    "valura"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 42,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "preload": false,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "box",
        "label": "Box",
        "query": "uat-env",
        "current": {
          "text": "uat-env",
          "value": "uat-env"
        },
        "hide": 2
      },
      {
        "type": "query",
        "name": "resource",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(container_last_seen{box=\"uat-env\"}, container_label_coolify_resourceName)",
        "query": {
          "qryType": 1,
          "query": "label_values(container_last_seen{box=\"uat-env\"}, container_label_coolify_resourceName)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Explore logs",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"loki\",\"queries\":[{\"expr\":\"{host=\\\"uat-env\\\"}\"}],\"range\":{\"from\":\"now-1h\",\"to\":\"now\"}}",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Known gap:** no Alloy agent deployed on this box yet, so the log panels below will show *no data* until it ships. Metrics (this row + service breakdown) are live today. See `../../../../../uat-box/README.md`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(container_last_seen{box=\"uat-env\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Restarts (1h)",
