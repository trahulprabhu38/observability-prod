    {
      "id": 15,
      "type": "logs",
      "title": "Errors, warnings & exceptions",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "pluginVersion": "12.3.2",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": false,
        "showControls": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{host=\"uat-env\", coolify_resource=~\"$resource\"} |~ \"(?i)(error|warn|fatal|critical|exception|traceback|panic)\"",
          "maxLines": 300,
          "legendFormat": ""
        }
      ]
    }
