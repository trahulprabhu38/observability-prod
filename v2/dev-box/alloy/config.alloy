// =============================================================================
//  Alloy on the dev box (10.200.2.51)  -  logs + trace forwarding
//  LOGS  -> Loki 10.200.2.52:3100    TRACES -> OTel Collector 10.200.2.52:4317
//  region label: coolify_project  (valura-development=UAE, global-valura-dev=IND)
// =============================================================================

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_coolify_projectName"]
    target_label  = "coolify_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_coolify_resourceName"]
    target_label  = "coolify_resource"
  }
  rule {
    source_labels = ["__meta_docker_container_label_coolify_environmentName"]
    target_label  = "coolify_env"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  forward_to    = [loki.process.containers.receiver]
  relabel_rules = discovery.relabel.containers.rules
}

loki.process "containers" {
  stage.static_labels {
    values = {
      env  = "dev",
      host = "dev-server-1",
    }
  }

  // JSON logs: pull the raw level into extracted["lvl_raw"].
  stage.json {
    expressions = {
      lvl_raw = "level",
      msg     = "msg",
      message = "message",
    }
  }

  // Non-JSON lines: best-effort level word from the raw text.
  stage.regex {
    expression = "(?i)(\"level\"|level=|lvl=)[\":= ]*(?P<lvl_txt>error|warn(?:ing)?|info|debug|trace|fatal|critical|panic|[1-6]0)"
  }

  // Pick json level if present, else the text one, into extracted["level"].
  stage.template {
    source   = "level"
    template = "{{ if .lvl_raw }}{{ .lvl_raw }}{{ else if .lvl_txt }}{{ .lvl_txt }}{{ else }}unknown{{ end }}"
  }

  // Normalise: lowercase + pino/bunyan numerics + synonyms.
  stage.template {
    source   = "level"
    template = "{{ $l := ToLower .Value }}{{ if or (eq $l \"10\") (eq $l \"trace\") }}trace{{ else if or (eq $l \"20\") (eq $l \"debug\") }}debug{{ else if or (eq $l \"30\") (eq $l \"info\") }}info{{ else if or (eq $l \"40\") (eq $l \"warn\") (eq $l \"warning\") }}warn{{ else if or (eq $l \"50\") (eq $l \"error\") (eq $l \"err\") }}error{{ else if or (eq $l \"60\") (eq $l \"fatal\") (eq $l \"critical\") (eq $l \"panic\") }}fatal{{ else }}unknown{{ end }}"
  }

  stage.labels {
    values = { level = "level" }
  }

  stage.label_keep {
    values = ["container", "image", "env", "host", "level",
              "compose_service", "coolify_project", "coolify_resource", "coolify_env"]
  }

  stage.drop {
    expression          = ".*(GET|HEAD) /(health|healthz|ping|ready|live)[ \"].*"
    drop_counter_reason = "healthcheck"
  }

  forward_to = [loki.write.remote.receiver]
}

loki.write "remote" {
  endpoint {
    url = "http://10.200.2.52:3100/loki/api/v1/push"
  }
  external_labels = {
    job = "docker-containers",
  }
}

// ------------------------------------------------------------------- traces ---
otelcol.receiver.otlp "in" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout = "2s"
  output {
    traces = [otelcol.exporter.otlp.collector.input]
  }
}

otelcol.exporter.otlp "collector" {
  client {
    endpoint = "10.200.2.52:4317"
    tls { insecure = true }
  }
}

livedebugging {
  enabled = true
}
